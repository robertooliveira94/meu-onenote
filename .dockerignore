# nunca deixe as anotações entrarem na imagem — nem por engano.
dados

node_modules
.next
out
build
logs

.git
.gitignore

npm-debug.log*
.DS_Store
*.tsbuildinfo

# só usado pelo docker compose no host, para substituir DADOS_HOST_PATH e
# PORTA_HOST — o container não precisa dele, e nunca deveria estar em uma
# imagem publicada.
.env
.env.example

# scripts do serviço do Windows não fazem sentido dentro do container; o
# `copiar-fontes-excalidraw.mjs` permanece porque o `prebuild` precisa dele
scripts/*.ps1
*.bat

# artefatos locais do mapa do código não participam da aplicação e tornam o
# contexto do Docker desnecessariamente grande
graphify-out
