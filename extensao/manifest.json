{
  "manifest_version": 3,
  "name": "Meu bloco de anotações",
  "short_name": "Meu bloco",
  "version": "1.2.0",
  "description": "Captura e preenche senhas do seu cofre local, abre seus links favoritos e salva produtos na sua lista de compras sem sair da aba.",
  "icons": {
    "16": "icones/icone-16.png",
    "32": "icones/icone-32.png",
    "48": "icones/icone-48.png",
    "128": "icones/icone-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icones/icone-16.png",
      "32": "icones/icone-32.png",
      "48": "icones/icone-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["storage", "sidePanel", "activeTab"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src http://localhost/* http://127.0.0.1/*;"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "opcoes.html"
}
